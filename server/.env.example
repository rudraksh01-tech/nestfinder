PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nestfinder?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me
# From @BotFather on Telegram; leave empty to turn Telegram alerts off
TELEGRAM_BOT_TOKEN=
# Browser push keys. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@nestfinder.test
