PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nestfinder?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me
# From @BotFather on Telegram; leave empty to turn Telegram alerts off
TELEGRAM_BOT_TOKEN=
# Browser push keys. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@nestfinder.test
# Free key from https://console.groq.com (AI chat)
GROQ_API_KEY=
# LLM tracing (free at https://cloud.langfuse.com); leave the keys empty to turn it off.
# Use https://us.cloud.langfuse.com if your Langfuse project is in the US region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
